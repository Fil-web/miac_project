# Образец для развёртывания на сервере. Скопируйте в .env и задайте секреты.
# Имя БД и пользователя можно оставить; они должны совпадать с DATABASE_URL.
POSTGRES_DB=miac_inventory
POSTGRES_USER=miac_app
# Задайте новый случайный пароль. Повторите его в DATABASE_URL.
POSTGRES_PASSWORD=change_me_database_password
# Имя db — адрес PostgreSQL внутри сети Docker Compose; его оставьте.
DATABASE_URL=postgresql+psycopg://miac_app:change_me_database_password@db:5432/miac_inventory
# Задайте отдельное случайное значение длиной не менее 32 символов.
SESSION_SECRET=change_me_to_a_random_string_at_least_32_characters
# После настройки HTTPS на reverse proxy установите true.
SESSION_HTTPS_ONLY=false
# Добавьте доменное имя сервиса; 127.0.0.1 оставьте для внутренней проверки /health.
ALLOWED_HOSTS=localhost,127.0.0.1

# Первичные учётные записи создаются только при отсутствии. Пароли замените.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
STOREKEEPER_USERNAME=storekeeper
STOREKEEPER_PASSWORD=storekeeper
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer

